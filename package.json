{
  "name": "code-blocks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @code-blocks/editor --",
    "dev:server": "npm run dev -w @code-blocks/server",
    "build": "npm run build -w @code-blocks/editor",
    "preview": "npm run preview -w @code-blocks/editor --",
    "start:server": "npm run start -w @code-blocks/server",
    "typecheck": "tsc -p packages/engine && tsc -p apps/editor && tsc -p apps/server && tsc -p e2e",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:all": "playwright test",
    "e2e:install": "playwright install chromium",
    "e2e:install:all": "playwright install chromium firefox webkit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
